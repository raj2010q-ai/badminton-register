<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Badminton Academy Register</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- React & ReactDOM -->
  <script src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
  <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
  <!-- Babel -->
  <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
</head>
<body class="bg-slate-50 text-slate-800">
  <div id="root"></div>

  <script type="text/babel">
    const { useState, useMemo, useEffect } = React;

    const LOCAL_STORAGE_KEY = 'my_badminton_academy_students_list';

    // Simple Icons
    const Icons = {
      Users: () => <svg className="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" /></svg>,
      UserPlus: () => <svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" /></svg>,
      CheckCircle: () => <svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>,
      XCircle: () => <svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>,
      Trash2: () => <svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>,
      Phone: () => <svg className="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>,
      Search: () => <svg className="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>,
      User: () => <svg className="w-12 h-12 text-slate-300 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>,
      Info: () => <svg className="w-3.5 h-3.5 text-slate-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>,
      Edit2: () => <svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg>,
      X: () => <svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M6 18L18 6M6 6l12 12" /></svg>,
      Check: () => <svg className="w-4 h-4 text-emerald-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M5 13l4 4L19 7" /></svg>,
      AlertCircle: () => <svg className="w-6 h-6 text-rose-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
    };

    function App() {
      // Load saved list immediately
      const [students, setStudents] = useState(() => {
        try {
          const saved = localStorage.getItem(LOCAL_STORAGE_KEY);
          return saved ? JSON.parse(saved) : [
            { id: '1', name: "Rahul Sharma", phone: "9876543210", age: "14", feeStatus: "Paid", notes: "Morning Batch (6 AM - 8 AM)" },
            { id: '2', name: "Priya Patel", phone: "9876543211", age: "16", feeStatus: "Unpaid", notes: "Evening Batch (5 PM - 7 PM)" }
          ];
        } catch (e) {
          return [];
        }
      });

      const [isAdding, setIsAdding] = useState(false);
      const [editingId, setEditingId] = useState(null);
      const [searchTerm, setSearchTerm] = useState("");
      const [toastMessage, setToastMessage] = useState("");
      const [studentToDelete, setStudentToDelete] = useState(null);

      const [formData, setFormData] = useState({
        name: '',
        phone: '',
        age: '',
        feeStatus: 'Unpaid',
        notes: ''
      });

      // Save to device memory on every single update
      useEffect(() => {
        try {
          localStorage.setItem(LOCAL_STORAGE_KEY, JSON.stringify(students));
        } catch (e) {
          console.error("Save error", e);
        }
      }, [students]);

      const showNotification = (msg) => {
        setToastMessage(msg);
        setTimeout(() => setToastMessage(""), 3000);
      };

      const handleInputChange = (e) => {
        const { name, value } = e.target;
        setFormData(prev => ({ ...prev, [name]: value }));
      };

      const startEditing = (student) => {
        setEditingId(student.id);
        setFormData({
          name: student.name || '',
          phone: student.phone || '',
          age: student.age || '',
          feeStatus: student.feeStatus || 'Unpaid',
          notes: student.notes || ''
        });
        setIsAdding(true);
      };

      const handleSubmit = (e) => {
        e.preventDefault();
        if (!formData.name.trim()) return;

        if (editingId) {
          setStudents(prev => prev.map(s => s.id === editingId ? { ...formData, id: editingId } : s));
          showNotification("Student details updated!");
        } else {
          const newStudent = { ...formData, id: Date.now().toString() };
          setStudents(prev => [newStudent, ...prev]);
          showNotification("New student saved successfully!");
        }

        setFormData({ name: '', phone: '', age: '', feeStatus: 'Unpaid', notes: '' });
        setEditingId(null);
        setIsAdding(false);
      };

      const toggleFeeStatus = (student) => {
        const newStatus = student.feeStatus === "Paid" ? "Unpaid" : "Paid";
        setStudents(prev => prev.map(s => s.id === student.id ? { ...s, feeStatus: newStatus } : s));
        showNotification(`${student.name} marked as ${newStatus}`);
      };

      const confirmDelete = () => {
        if (!studentToDelete) return;
        setStudents(prev => prev.filter(s => s.id !== studentToDelete.id));
        showNotification(`Removed ${studentToDelete.name}`);
        setStudentToDelete(null);
      };

      const stats = useMemo(() => {
        const total = students.length;
        const paid = students.filter(s => s.feeStatus === "Paid").length;
        const unpaid = total - paid;
        return { total, paid, unpaid };
      }, [students]);

      const filteredStudents = useMemo(() => {
        return students.filter(s => 
          s.name.toLowerCase().includes(searchTerm.toLowerCase()) ||
          (s.phone && s.phone.includes(searchTerm))
        );
      }, [students, searchTerm]);

      return (
        <div className="min-h-screen bg-slate-50 text-slate-800 font-sans pb-24">
          {toastMessage && (
            <div className="fixed top-4 left-1/2 -translate-x-1/2 z-50 bg-slate-800 text-white px-5 py-3 rounded-full shadow-lg flex items-center gap-2 text-sm font-medium">
              <Icons.Check />
              <span>{toastMessage}</span>
            </div>
          )}

          <header className="bg-emerald-600 text-white p-4 shadow-md sticky top-0 z-10">
            <div className="max-w-4xl mx-auto flex justify-between items-center">
              <div className="flex items-center space-x-2">
                <Icons.Users />
                <div>
                  <h1 className="text-xl font-bold tracking-wide leading-none">Badminton Register</h1>
                  <p className="text-xs text-emerald-100 mt-1">Academy Details</p>
                </div>
              </div>
              <button 
                onClick={() => {
                  if (isAdding) {
                    setIsAdding(false);
                    setEditingId(null);
                    setFormData({ name: '', phone: '', age: '', feeStatus: 'Unpaid', notes: '' });
                  } else {
                    setIsAdding(true);
                  }
                }}
                className="bg-emerald-500 hover:bg-emerald-400 text-white px-4 py-2 rounded-full font-medium transition flex items-center space-x-1 text-sm md:text-base shadow-sm"
              >
                {isAdding ? <Icons.X /> : <Icons.UserPlus />}
                <span>{isAdding ? 'Close' : 'Add Student'}</span>
              </button>
            </div>
          </header>

          <main className="max-w-4xl mx-auto p-4 space-y-6">
            <div className="grid grid-cols-3 gap-3 md:gap-6">
              <div className="bg-white p-4 rounded-xl shadow-sm border border-slate-100 flex flex-col items-center justify-center text-center">
                <span className="text-xs md:text-sm text-slate-500 font-medium">Total Students</span>
                <span className="text-2xl md:text-3xl font-bold text-slate-700">{stats.total}</span>
              </div>
              <div className="bg-white p-4 rounded-xl shadow-sm border border-emerald-100 flex flex-col items-center justify-center text-center">
                <span className="text-xs md:text-sm text-emerald-600 font-medium">Fees Paid</span>
                <span className="text-2xl md:text-3xl font-bold text-emerald-600">{stats.paid}</span>
              </div>
              <div className="bg-white p-4 rounded-xl shadow-sm border border-rose-100 flex flex-col items-center justify-center text-center">
                <span className="text-xs md:text-sm text-rose-500 font-medium">Fees Pending</span>
                <span className="text-2xl md:text-3xl font-bold text-rose-500">{stats.unpaid}</span>
              </div>
            </div>

            {isAdding && (
              <div className="bg-white p-5 md:p-6 rounded-xl shadow-md border border-slate-200">
                <h2 className="text-lg font-bold mb-4 text-emerald-700 border-b pb-2">
                  {editingId ? "Edit Student Details" : "New Student Entry"}
                </h2>
                <form onSubmit={handleSubmit} className="space-y-4">
                  <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                      <label className="block text-sm font-medium text-slate-600 mb-1">Student Full Name *</label>
                      <input 
                        type="text" 
                        name="name"
                        required
                        value={formData.name}
                        onChange={handleInputChange}
                        className="w-full p-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-500 outline-none transition"
                        placeholder="e.g. Ramesh Kumar"
                      />
                    </div>
                    <div>
                      <label className="block text-sm font-medium text-slate-600 mb-1">Phone Number</label>
                      <input 
                        type="tel" 
                        name="phone"
                        value={formData.phone}
                        onChange={handleInputChange}
                        className="w-full p-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-500 outline-none transition"
                        placeholder="e.g. 9876543210"
                      />
                    </div>
                    <div>
                      <label className="block text-sm font-medium text-slate-600 mb-1">Age</label>
                      <input 
                        type="number" 
                        name="age"
                        value={formData.age}
                        onChange={handleInputChange}
                        className="w-full p-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-500 outline-none transition"
                        placeholder="e.g. 14"
                      />
                    </div>
                    <div>
                      <label className="block text-sm font-medium text-slate-600 mb-1">Fee Status</label>
                      <select 
                        name="feeStatus"
                        value={formData.feeStatus}
                        onChange={handleInputChange}
                        className="w-full p-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-500 outline-none transition bg-white"
                      >
                        <option value="Unpaid">Unpaid</option>
                        <option value="Paid">Paid</option>
                      </select>
                    </div>
                  </div>
                  <div>
                    <label className="block text-sm font-medium text-slate-600 mb-1">Batch Timings / Notes</label>
                    <textarea 
                      name="notes"
                      value={formData.notes}
                      onChange={handleInputChange}
                      rows="2"
                      className="w-full p-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-500 outline-none transition"
                      placeholder="e.g. Evening batch 5PM"
                    ></textarea>
                  </div>
                  <div className="flex justify-end gap-2 pt-2">
                    <button 
                      type="button"
                      onClick={() => {
                        setIsAdding(false);
                        setEditingId(null);
                      }}
                      className="px-4 py-2 border border-slate-300 text-slate-600 rounded-lg hover:bg-slate-50 transition"
                    >
                      Cancel
                    </button>
                    <button 
                      type="submit"
                      className="bg-emerald-600 hover:bg-emerald-700 text-white px-6 py-2 rounded-lg font-medium transition shadow-sm"
                    >
                      {editingId ? "Update Student" : "Save Student"}
                    </button>
                  </div>
                </form>
              </div>
            )}

            <div className="relative">
              <div className="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <Icons.Search />
              </div>
              <input
                type="text"
                className="block w-full pl-10 pr-3 py-3 border border-slate-200 rounded-xl bg-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-emerald-500 transition shadow-sm"
                placeholder="Search by name or phone..."
                value={searchTerm}
                onChange={(e) => setSearchTerm(e.target.value)}
              />
            </div>

            <div className="space-y-3">
              {filteredStudents.length === 0 ? (
                <div className="text-center py-10 bg-white rounded-xl border border-slate-200 border-dashed">
                  <Icons.User />
                  <p className="text-slate-500 font-medium">No students found.</p>
                </div>
              ) : (
                filteredStudents.map((student) => (
                  <div key={student.id} className="bg-white p-4 rounded-xl shadow-sm border border-slate-100 flex flex-col md:flex-row md:items-center justify-between gap-4 transition hover:shadow-md">
                    <div className="flex-1">
                      <div className="flex items-center gap-2 mb-1">
                        <h3 className="text-lg font-bold text-slate-800">{student.name}</h3>
                        {student.age && (
                          <span className="bg-slate-100 text-slate-600 text-xs px-2 py-0.5 rounded-full">
                            Age: {student.age}
                          </span>
                        )}
                      </div>
                      
                      <div className="text-sm text-slate-600 space-y-1">
                        {student.phone && (
                          <div className="flex items-center gap-1.5">
                            <Icons.Phone />
                            <a href={`tel:${student.phone}`} className="hover:text-emerald-600 font-mono">
                              {student.phone}
                            </a>
                          </div>
                        )}
                        {student.notes && (
                          <div className="flex items-start gap-1.5 mt-1 text-slate-500">
                            <Icons.Info />
                            <span>{student.notes}</span>
                          </div>
                        )}
                      </div>
                    </div>

                    <div className="flex items-center gap-3 pt-3 md:pt-0 border-t md:border-t-0 border-slate-100">
                      <button
                        onClick={() => toggleFeeStatus(student)}
                        className={`flex-1 md:flex-none flex items-center justify-center gap-1.5 px-4 py-2 rounded-lg font-medium text-sm transition border ${
                          student.feeStatus === 'Paid' 
                            ? 'bg-emerald-50 text-emerald-700 border-emerald-200 hover:bg-emerald-100' 
                            : 'bg-rose-50 text-rose-700 border-rose-200 hover:bg-rose-100'
                        }`}
                      >
                        {student.feeStatus === 'Paid' ? <Icons.CheckCircle /> : <Icons.XCircle />}
                        <span>{student.feeStatus}</span>
                      </button>

                      <button
                        onClick={() => startEditing(student)}
                        className="p-2 text-slate-400 hover:text-emerald-600 hover:bg-emerald-50 rounded-lg transition"
                      >
                        <Icons.Edit2 />
                      </button>
                      
                      <button
                        onClick={() => setStudentToDelete(student)}
                        className="p-2 text-slate-400 hover:text-rose-600 hover:bg-rose-50 rounded-lg transition"
                      >
                        <Icons.Trash2 />
                      </button>
                    </div>
                  </div>
                ))
              )}
            </div>
          </main>

          {studentToDelete && (
            <div className="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-50 flex items-center justify-center p-4">
              <div className="bg-white rounded-2xl p-6 max-w-sm w-full shadow-2xl space-y-4">
                <div className="flex items-center gap-3">
                  <Icons.AlertCircle />
                  <h3 className="text-lg font-bold text-slate-800">Delete Record?</h3>
                </div>
                <p className="text-sm text-slate-600">
                  Are you sure you want to delete <span className="font-bold text-slate-800">{studentToDelete.name}</span>?
                </p>
                <div className="flex justify-end gap-2 pt-2">
                  <button 
                    onClick={() => setStudentToDelete(null)}
                    className="px-4 py-2 text-slate-600 border border-slate-200 rounded-lg hover:bg-slate-50 transition text-sm font-medium"
                  >
                    Cancel
                  </button>
                  <button 
                    onClick={confirmDelete}
                    className="px-4 py-2 bg-rose-600 text-white rounded-lg hover:bg-rose-700 transition text-sm font-medium shadow-sm"
                  >
                    Delete Student
                  </button>
                </div>
              </div>
            </div>
          )}
        </div>
      );
    }

    ReactDOM.createRoot(document.getElementById('root')).render(<App />);
  </script>
</body>
</html>
